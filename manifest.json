{
  "manifest_version": 3,
  "name": "Geo Game Autoplay",
  "version": "2.0",
  "description": "Auto-plays the World Geography Game",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Geo Autoplay"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["*://world-geography-games.com/*"],
  "content_scripts": [{
    "matches": ["*://world-geography-games.com/*"],
    "js": ["content_script.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["inject.js"],
    "matches": ["*://world-geography-games.com/*"]
  }]
}